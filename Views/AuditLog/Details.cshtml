@model EAEmployee.Net8.Models.AuditLog
@{
    ViewData["Title"] = "Audit Log Details";
}

<style>
    .detail-card { background: #fff; border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,.08); padding: 2rem; max-width: 700px; border: 1px solid #eee; }
    .detail-card h2 { font-weight: 700; color: #1a1a2e; margin-bottom: .25rem; }
    .info-row { display: flex; padding: .6rem 0; border-bottom: 1px solid #f0f0f0; }
    .info-label { font-weight: 600; color: #495057; min-width: 120px; font-size: .88rem; flex-shrink: 0; }
    .info-value { color: #212529; font-size: .88rem; word-break: break-all; }
    .json-block { background: #f8f9fa; border-radius: 8px; padding: 1rem; font-family: 'SF Mono', 'Fira Code', monospace; font-size: .82rem; color: #495057; white-space: pre-wrap; max-height: 300px; overflow-y: auto; border: 1px solid #e9ecef; }
    .action-badge { display: inline-block; padding: .2rem .6rem; border-radius: 6px; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; }
    .action-create { background: #d1e7dd; color: #0a3622; }
    .action-update { background: #fff3cd; color: #664d03; }
    .action-delete { background: #f8d7da; color: #842029; }
</style>

<div class="detail-card">
    <h2>&#128270; Audit Entry #@Model.Id</h2>

    <div class="mt-3">
        <div class="info-row">
            <span class="info-label">Action</span>
            <span class="info-value"><span class="action-badge @(Model.Action switch { "Create" => "action-create", "Update" => "action-update", "Delete" => "action-delete", _ => "" })">@Model.Action</span></span>
        </div>
        <div class="info-row">
            <span class="info-label">Entity Type</span>
            <span class="info-value">@Model.EntityType</span>
        </div>
        @if (Model.EntityId.HasValue)
        {
            <div class="info-row">
                <span class="info-label">Entity ID</span>
                <span class="info-value">@Model.EntityId</span>
            </div>
        }
        <div class="info-row">
            <span class="info-label">User</span>
            <span class="info-value">@(!string.IsNullOrEmpty(Model.UserName) ? Model.UserName : "System")</span>
        </div>
        <div class="info-row">
            <span class="info-label">IP Address</span>
            <span class="info-value">@Model.IpAddress ?? "N/A"</span>
        </div>
        <div class="info-row">
            <span class="info-label">Timestamp</span>
            <span class="info-value">@Model.Timestamp.ToString("MMMM dd, yyyy 'at' HH:mm:ss UTC")</span>
        </div>
        <div class="info-row">
            <span class="info-label">Summary</span>
            <span class="info-value">@Model.Summary</span>
        </div>

        @if (!string.IsNullOrEmpty(Model.OldValues))
        {
            <div class="mt-3">
                <label style="font-weight:600;color:#495057;font-size:.85rem;">Old Values (Before)</label>
                <pre class="json-block mt-1">@Model.OldValues</pre>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.NewValues))
        {
            <div class="mt-3">
                <label style="font-weight:600;color:#495057;font-size:.85rem;">New Values (After)</label>
                <pre class="json-block mt-1">@Model.NewValues</pre>
            </div>
        }
    </div>

    <a asp-action="Index" style="display:inline-flex;align-items:center;gap:.4rem;margin-top:1.5rem;color:#6c757d;text-decoration:none;font-size:.9rem;">&#8592; Back to Audit Log</a>
</div>
