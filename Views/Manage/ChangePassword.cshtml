@model EAEmployee.Net8.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<style>
    .account-card {
        background: #fff; border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,.08);
        padding: 2rem; max-width: 500px; border: 1px solid #eee;
    }
    .account-card h2 { font-weight: 700; color: #1a1a2e; margin-bottom: .25rem; }
    .account-card .subtitle { color: #6c757d; font-size: .9rem; margin-bottom: 1.5rem; }
    .form-label { font-weight: 600; font-size: .85rem; color: #495057; }
    .btn-save { background: linear-gradient(135deg, #0d6efd, #0b5ed7); border: none; padding: .55rem 1.5rem; font-weight: 600; }
    .btn-cancel { color: #6c757d; text-decoration: none; padding: .55rem 1rem; }
</style>

<div class="account-card">
    <h2>@ViewData["Title"]</h2>
    <p class="subtitle">Update your account password. Your new password must be at least 6 characters.</p>

    @if (!string.IsNullOrEmpty(ViewBag.StatusMessage as string))
    {
        <div class="alert alert-success">@ViewBag.StatusMessage</div>
    }

    <form asp-action="ChangePassword" method="post">
        <input type="hidden" asp-for="UserName" />
        <input type="hidden" asp-for="Email" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="OldPassword" class="form-label"></label>
            <input asp-for="OldPassword" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="OldPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-save">Change Password</button>
        <a asp-action="Index" class="btn-cancel ms-3">Cancel</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
